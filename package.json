{
  "name": "bb-plugin-files",
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.101"
  },
  "bb": {
    "name": "Files",
    "description": "A path-first file browser, picker and media viewer for every BB machine.",
    "branding": {
      "icon": "Folder"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.101",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "format": "prettier --write *.ts *.tsx *.css tests/*.ts tests/*.mjs",
    "fixtures": "node tests/fixtures.mjs"
  }
}
