{
  "name": "bb-plugin-files",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "bb": ">=0.44.0",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Files",
    "description": "A path-first file browser, picker and media viewer for every BB machine.",
    "branding": {
      "icon": "Folder"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hono": "^4.13.11",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "format": "prettier --write *.ts *.tsx *.css tests/*.ts tests/*.mjs",
    "fixtures": "node tests/fixtures.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "description": "A path-first file browser, picker and media viewer for every BB machine.",
  "license": "MIT",
  "author": "Lucas Shamanic",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShamanicArts/bb-plugin-files.git"
  },
  "homepage": "https://github.com/ShamanicArts/bb-plugin-files#readme",
  "bugs": {
    "url": "https://github.com/ShamanicArts/bb-plugin-files/issues"
  },
  "files": [
    "dist/",
    "skills/",
    "*.ts",
    "*.tsx",
    "*.css",
    "tsconfig.json",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "CHANGELOG.md",
    "VERIFICATION.md",
    "docs/screenshots/"
  ]
}
